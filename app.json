{
  "expo": {
    "name": "Scrolody",
    "slug": "scrolody",
    "scheme": "scrolody",
    "icon": "./assets/scrolody-mascot.png",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.scrolody.app"
    },
    "extra": {
      "apkReleaseRepository": ""
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/scrolody-mascot.png",
          "imageWidth": 136,
          "backgroundColor": "#FAF8FF",
          "dark": {
            "image": "./assets/scrolody-mascot.png",
            "backgroundColor": "#12131A"
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
